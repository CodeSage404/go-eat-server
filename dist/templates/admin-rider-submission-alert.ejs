<!-- Admin Courier Submission Alert Hero Icon -->
<div style="text-align: center; margin: 10px 0 16px;">
  <div style="width: 72px; height: 72px; border-radius: 50%; background-color: #ECFDF5; border: 2px solid #A7F3D0; margin: 0 auto; text-align: center; line-height: 72px; font-size: 32px;">
    🛵
  </div>
</div>

<!-- Title & Accent Bar -->
<div style="text-align: center;">
  <h1 style="margin: 0; font-size: 23px; font-weight: 800; color: #004320; letter-spacing: -0.3px;">
    New Courier Documents Submitted
  </h1>
  <div style="width: 44px; height: 3px; background-color: #FFB800; border-radius: 2px; margin: 10px auto 18px;"></div>
</div>

<!-- Greeting & Notice -->
<div style="text-align: left; max-width: 480px; margin: 0 auto 20px;">
  <p style="font-size: 14px; font-weight: 700; color: #1F2937; margin: 0 0 8px;">
    Hello GoEatOne Admin Team,
  </p>
  <p style="font-size: 13.5px; line-height: 1.6; color: #4B5563; margin: 0;">
    A courier has submitted their onboarding verification documents on GoEatOne and their profile is currently <strong>awaiting review and approval from admin</strong>.
  </p>
</div>

<!-- Courier Details Box -->
<div style="background-color: #F9FAFB; border: 1px solid #E5E7EB; border-radius: 16px; padding: 20px; max-width: 480px; margin: 0 auto 22px;">
  <div style="font-size: 12px; font-weight: 800; color: #004320; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 12px; border-bottom: 1px solid #E5E7EB; padding-bottom: 8px;">
    Courier Verification Details
  </div>

  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="font-size: 13px;">
    <tr>
      <td style="padding: 6px 0; color: #6B7280; width: 135px;">Courier Name:</td>
      <td style="padding: 6px 0; font-weight: 700; color: #111827;"><%= riderName %></td>
    </tr>
    <tr>
      <td style="padding: 6px 0; color: #6B7280;">Email:</td>
      <td style="padding: 6px 0; font-weight: 600; color: #004320;"><%= email %></td>
    </tr>
    <tr>
      <td style="padding: 6px 0; color: #6B7280;">Phone Number:</td>
      <td style="padding: 6px 0; font-weight: 600; color: #111827;"><%= phoneNumber %></td>
    </tr>
    <tr>
      <td style="padding: 6px 0; color: #6B7280;">Delivery Method:</td>
      <td style="padding: 6px 0; font-weight: 600; color: #111827; text-transform: capitalize;"><%= typeof deliveryMethod !== 'undefined' && deliveryMethod ? deliveryMethod : 'Motorcycle' %></td>
    </tr>
    <tr>
      <td style="padding: 6px 0; color: #6B7280;">Vehicle Reg No:</td>
      <td style="padding: 6px 0; font-weight: 600; color: #374151;"><%= typeof vehicleReg !== 'undefined' && vehicleReg ? vehicleReg : 'N/A' %></td>
    </tr>
    <tr>
      <td style="padding: 6px 0; color: #6B7280;">Country / Region:</td>
      <td style="padding: 6px 0; font-weight: 600; color: #111827;"><%= typeof country !== 'undefined' && country ? country : 'Nigeria' %></td>
    </tr>
    <tr>
      <td style="padding: 6px 0; color: #6B7280;">Documents:</td>
      <td style="padding: 6px 0; font-weight: 600; color: #15803D;"><%= typeof documentsList !== 'undefined' && documentsList ? documentsList : 'Courier Documents Uploaded' %></td>
    </tr>
    <tr>
      <td style="padding: 6px 0; color: #6B7280;">Submitted At:</td>
      <td style="padding: 6px 0; font-weight: 500; color: #4B5563;"><%= typeof submittedAt !== 'undefined' && submittedAt ? submittedAt : new Date().toUTCString() %></td>
    </tr>
  </table>
</div>

<!-- Review Alert Card -->
<div style="background-color: #FEF9C3; border: 1.5px solid #FDE047; border-left: 4px solid #FFB800; border-radius: 12px; padding: 14px 18px; max-width: 480px; margin: 0 auto 24px;">
  <p style="margin: 0 0 4px 0; font-size: 13.5px; font-weight: 800; color: #713F12;">
    ⏳ Action Required: Review & Approval
  </p>
  <p style="margin: 0; font-size: 12.5px; line-height: 1.55; color: #854D0E;">
    This courier profile is awaiting verification. Please review their submitted identity documents, driver's license, and vehicle details to approve or request corrections in the Admin Portal.
  </p>
</div>

<!-- Admin Portal CTA Button -->
<div style="text-align: center; margin: 28px 0 20px 0;">
  <a href="<%= typeof reviewUrl !== 'undefined' && reviewUrl ? reviewUrl : 'https://admin.goeatone.com/management/riders' %>" style="background-color: #004320; color: #ffffff; text-decoration: none; padding: 14px 32px; border-radius: 30px; font-weight: 700; font-size: 14.5px; display: inline-block;">
    Review Courier in Admin Portal →
  </a>
</div>

<p style="font-size: 12px; color: #9CA3AF; text-align: center; margin-top: 24px;">
  This is an automated operational notification dispatched to support@goeatone.com.
</p>
