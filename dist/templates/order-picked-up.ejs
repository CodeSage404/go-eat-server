<!-- Go.Compare / Rami Niemi Inspired Rider Hero -->
<div style="text-align: center; margin-bottom: 20px;">
  <h1 style="margin: 0; font-size: 36px; line-height: 1.05; font-weight: 900; color: #133824; letter-spacing: -1px; text-transform: uppercase;">
    ORDER<br/><span style="color: #F59E0B;">PICKED UP!</span>
  </h1>
  <p style="font-size: 15px; font-weight: 700; color: #1F2937; margin: 8px auto 0; max-width: 420px; line-height: 1.4;">
    Your courier has grabbed your food and is on the move.
  </p>
</div>

<!-- Centerpiece Vector Illustration: Courier On The Way -->
<div style="text-align: center; margin: 0 auto 22px; max-width: 480px; background-color: #FFFFFF; border-radius: 20px; padding: 12px; border: 1px solid #F3F4F6; box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);">
  <img 
    src="<%= typeof emailAssetsUrl !== 'undefined' ? emailAssetsUrl + '/rider-enroute.jpg' : 'cid:goeat_rider-enroute' %>" 
    alt="Courier On The Way" 
    width="460" 
    style="width: 100%; max-width: 460px; height: auto; display: block; margin: 0 auto; border-radius: 14px; border: 0;" 
  />
</div>

<!-- Greeting & Message -->
<div style="text-align: center; max-width: 440px; margin: 0 auto 20px;">
  <p style="font-size: 14px; font-weight: 800; color: #133824; margin: 0 0 6px;">
    Good news, <%= typeof customerName !== 'undefined' && customerName ? customerName : 'there' %>! 🛍️
  </p>
  <p style="font-size: 13px; line-height: 1.5; color: #4B5563; margin: 0;">
    The kitchen just handed off your bag to your courier. It’s packed warm and heading towards you right now.
  </p>
</div>

<!-- Live Order Progress Stepper (Mobile Fluid) -->
<div style="background-color: #F9FAFB; border: 1px solid #F3F4F6; border-radius: 18px; padding: 16px 10px; margin-bottom: 20px;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
    <tr>
      <!-- Step 1: Kitchen (Completed) -->
      <td class="stepper-step" align="center" style="vertical-align: top; width: 22%; text-align: center;">
        <div style="width: 32px; height: 32px; border-radius: 50%; background-color: #059669; color: #FFFFFF; text-align: center; line-height: 32px; font-size: 14px; margin: 0 auto 6px;">
          🍳
        </div>
        <div style="font-size: 11px; font-weight: 800; color: #059669;">Kitchen</div>
        <div style="font-size: 9.5px; color: #059669; margin-top: 1px;">
          (<%= typeof kitchenTime !== 'undefined' ? kitchenTime : 'Completed' %>)
        </div>
      </td>

      <!-- Step 1-2 Connector: Solid Green -->
      <td align="center" style="vertical-align: middle; width: 4%; padding-bottom: 18px;">
        <div style="height: 2px; background-color: #059669; width: 100%;"></div>
      </td>

      <!-- Step 2: Picked up (Completed) -->
      <td class="stepper-step" align="center" style="vertical-align: top; width: 22%; text-align: center;">
        <div style="width: 32px; height: 32px; border-radius: 50%; background-color: #059669; color: #FFFFFF; text-align: center; line-height: 32px; font-size: 14px; margin: 0 auto 6px;">
          🛍️
        </div>
        <div style="font-size: 11px; font-weight: 800; color: #059669;">Picked up</div>
        <div style="font-size: 9.5px; color: #059669; margin-top: 1px;">
          (<%= typeof pickupTime !== 'undefined' ? pickupTime : 'Ready' %>)
        </div>
      </td>

      <!-- Step 2-3 Connector: Solid Green -->
      <td align="center" style="vertical-align: middle; width: 4%; padding-bottom: 18px;">
        <div style="height: 2px; background-color: #059669; width: 100%;"></div>
      </td>

      <!-- Step 3: In-transit (Active) -->
      <td class="stepper-step" align="center" style="vertical-align: top; width: 22%; text-align: center;">
        <div style="width: 32px; height: 32px; border-radius: 50%; background-color: #059669; color: #FFFFFF; text-align: center; line-height: 32px; font-size: 14px; margin: 0 auto 6px;">
          🛵
        </div>
        <div style="font-size: 11px; font-weight: 800; color: #059669;">In-transit</div>
        <div style="font-size: 9.5px; color: #059669; margin-top: 1px;">
          (<%= typeof transitTime !== 'undefined' ? transitTime : 'On route' %>)
        </div>
      </td>

      <!-- Step 3-4 Connector: Dotted Grey -->
      <td align="center" style="vertical-align: middle; width: 4%; color: #D1D5DB; font-size: 11px; padding-bottom: 18px;">
        ···
      </td>

      <!-- Step 4: Arrived -->
      <td class="stepper-step" align="center" style="vertical-align: top; width: 22%; text-align: center;">
        <div style="width: 32px; height: 32px; border-radius: 50%; background-color: #E5E7EB; color: #6B7280; text-align: center; line-height: 32px; font-size: 14px; margin: 0 auto 6px;">
          📍
        </div>
        <div style="font-size: 11px; font-weight: 600; color: #6B7280;">Arrived</div>
      </td>
    </tr>
  </table>
</div>

<!-- Order Summary Quick Card -->
<% 
  var curr = typeof currencySymbol !== 'undefined' ? currencySymbol : '₦';
  var totalAmount = typeof total !== 'undefined' ? total : 0;
  var count = typeof itemsCount !== 'undefined' ? itemsCount : (typeof items !== 'undefined' && items ? items.length : 1);
%>
<div style="border: 1px solid #E5E7EB; border-radius: 18px; padding: 16px 18px; background-color: #FFFFFF; margin-bottom: 18px;">
  <div style="font-size: 12px; font-weight: 800; color: #133824; margin-bottom: 12px;">Order Summary</div>
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
    <tr>
      <td style="vertical-align: middle; width: 50px; padding-right: 12px;">
        <div style="position: relative; width: 44px; height: 44px;">
          <img src="https://res.cloudinary.com/dqtjja88b/image/upload/v1791211867/go_eat_email/email_order_accepted_bag.png" alt="Meal" style="width: 44px; height: 44px; border-radius: 50%; object-fit: cover; display: block; border: 1px solid #E5E7EB;" />
          <div style="position: absolute; top: -3px; right: -3px; background-color: #DC2626; color: #FFFFFF; font-size: 9px; font-weight: 800; border-radius: 50%; width: 16px; height: 16px; text-align: center; line-height: 16px;">
            <%= count %>
          </div>
        </div>
      </td>
      <td style="vertical-align: middle;">
        <div style="font-size: 13.5px; font-weight: 800; color: #111827;">
          <%= count %> <%= count === 1 ? 'Item' : 'Items' %>
        </div>
        <div style="font-size: 11px; color: #6B7280; margin-top: 2px;">
          View order details &gt;
        </div>
      </td>
      <td align="right" style="vertical-align: middle;">
        <div style="font-size: 10px; color: #6B7280; text-transform: uppercase;">Total Paid</div>
        <div style="font-size: 16px; font-weight: 800; color: #111827; margin-top: 1px;">
          <%= curr %><%= Number(totalAmount).toLocaleString() %>
        </div>
      </td>
    </tr>
  </table>
</div>

<!-- Order Meta Strip (Responsive Stacking on Mobile) -->
<div style="background-color: #F9FAFB; border: 1px solid #F3F4F6; border-radius: 16px; padding: 14px 18px; margin-bottom: 18px;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
    <tr>
      <td class="meta-box-col" style="vertical-align: top; width: 33.33%; padding-right: 8px;">
        <div style="font-size: 11px; font-weight: 600; color: #6B7280; margin-bottom: 3px;">
          📄 Order ID
        </div>
        <div style="font-size: 12.5px; font-weight: 800; color: #111827;">
          #<%= String(typeof orderId !== 'undefined' ? orderId : 'GE12345678').slice(-8).toUpperCase() %>
        </div>
      </td>
      <td class="meta-box-col" style="vertical-align: top; width: 33.33%; padding: 0 8px;">
        <div style="font-size: 11px; font-weight: 600; color: #6B7280; margin-bottom: 3px;">
          🕒 Order On
        </div>
        <div style="font-size: 12px; font-weight: 700; color: #111827;">
          <%= typeof orderDate !== 'undefined' && orderDate ? orderDate : (new Date().toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) + ' • ' + new Date().toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit' })) %>
        </div>
      </td>
      <td class="meta-box-col" style="vertical-align: top; width: 33.33%; padding-left: 8px;">
        <div style="font-size: 11px; font-weight: 600; color: #6B7280; margin-bottom: 3px;">
          📍 Delivery to
        </div>
        <div style="font-size: 11.5px; font-weight: 600; color: #374151; line-height: 1.3;">
          <%= typeof deliveryAddress !== 'undefined' && deliveryAddress ? deliveryAddress : 'Customer Delivery Address' %>
        </div>
      </td>
    </tr>
  </table>
</div>

<!-- Assigned Courier Card -->
<div style="background-color: #FFFFFF; border: 1px solid #E5E7EB; border-radius: 18px; padding: 14px 18px; margin-bottom: 20px;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
    <tr>
      <td style="vertical-align: middle; width: 48px; padding-right: 12px;">
        <img src="<%= typeof courierPhoto !== 'undefined' && courierPhoto ? courierPhoto : (typeof emailAssetsUrl !== 'undefined' ? emailAssetsUrl + '/logo.png' : 'cid:goeat_logo') %>" alt="Courier" style="width: 44px; height: 44px; border-radius: 50%; object-fit: cover; display: block; border: 1.5px solid #133824;" />
      </td>
      <td style="vertical-align: middle;">
        <div style="font-size: 13.5px; font-weight: 800; color: #111827;">
          <%= typeof courierName !== 'undefined' && courierName ? courierName : 'Samuel' %>
        </div>
        <div style="font-size: 11px; color: #059669; font-weight: 600; margin-top: 2px;">
          <%= typeof estimatedArrival !== 'undefined' ? estimatedArrival : '15 mins away' %>
        </div>
      </td>
      <% if (typeof courierPhone !== 'undefined' && courierPhone) { %>
      <td align="right" style="vertical-align: middle; width: 44px;">
        <a href="tel:<%= courierPhone %>" style="display: inline-block; width: 38px; height: 38px; border-radius: 50%; border: 1.5px solid #133824; text-align: center; line-height: 38px; text-decoration: none; color: #133824; background-color: #F0FDF4;">
          <span style="font-size: 16px;">📞</span>
        </a>
      </td>
      <% } else { %>
      <td align="right" style="vertical-align: middle; width: 44px;">
        <div style="display: inline-block; width: 38px; height: 38px; border-radius: 50%; border: 1.5px solid #D1D5DB; text-align: center; line-height: 38px; color: #133824; background-color: #F9FAFB;">
          <span style="font-size: 16px;">📞</span>
        </div>
      </td>
      <% } %>
    </tr>
  </table>
</div>

<!-- Cross-Sell Upsell Card (Fluid Stacking) -->
<div style="background-color: #ECFDF5; border: 1px solid #A7F3D0; border-radius: 18px; padding: 16px 18px; margin-bottom: 22px;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
    <tr>
      <td class="fluid-stack-col" style="vertical-align: middle; padding-right: 12px; text-align: left;">
        <div style="font-size: 13.5px; font-weight: 800; color: #064E3B; margin-bottom: 2px;">
          Need anything else?
        </div>
        <div style="font-size: 11.5px; color: #047857; line-height: 1.4;">
          Explore groceries, essentials, pharmacy items and more on GoEat
        </div>
      </td>
      <td class="fluid-stack-col" align="right" style="vertical-align: middle; width: 110px; padding-top: 8px;">
        <a href="https://goeatone.com" target="_blank" style="display: inline-block; background-color: #133824; color: #FFFFFF !important; font-size: 12px; font-weight: 700; text-decoration: none; padding: 10px 20px; border-radius: 999px; text-align: center; white-space: nowrap;">
          Shop Now
        </a>
      </td>
    </tr>
  </table>
</div>

<!-- Signoff -->
<div style="text-align: center; margin-top: 10px;">
  <p style="font-size: 12.5px; font-weight: 600; color: #4B5563; margin: 0;">
    Thank you for ordering with <strong style="color: #133824;">GO<span style="color: #F59E0B;">EAT</span></strong>
  </p>
</div>
