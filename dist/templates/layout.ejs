<!DOCTYPE html>
<html lang="en" xmlns="http://www.w3.org/1999/xhtml" xmlns:v="urn:schemas-microsoft-com:vml" xmlns:o="urn:schemas-microsoft-com:office:office">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="x-apple-disable-message-reformatting">
  <meta name="format-detection" content="telephone=no,address=no,email=no,date=no,url=no">
  <title>GoEat</title>
  <!--[if mso]>
  <style type="text/css">
    body, table, td, h1, h2, h3, p, a, span { font-family: -apple-system, BlinkMacSystemFont, Arial, sans-serif !important; }
  </style>
  <![endif]-->
  <style type="text/css">
    html, body {
      margin: 0 auto !important;
      padding: 0 !important;
      height: 100% !important;
      width: 100% !important;
      background-color: #F4F6F5;
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
      color: #1F2937;
      -webkit-font-smoothing: antialiased;
      -ms-text-size-adjust: 100%;
      -webkit-text-size-adjust: 100%;
    }
    table, td {
      mso-table-lspace: 0pt !important;
      mso-table-rspace: 0pt !important;
      border-collapse: collapse !important;
    }
    img {
      -ms-interpolation-mode: bicubic;
      border: 0;
      height: auto;
      line-height: 100%;
      outline: none;
      text-decoration: none;
      max-width: 100%;
    }
    /* Mobile-Specific Responsive Overrides */
    @media only screen and (max-width: 600px) {
      .email-wrapper {
        padding: 0 !important;
      }
      .email-container {
        width: 100% !important;
        max-width: 100% !important;
        border-radius: 0 !important;
        border-left: none !important;
        border-right: none !important;
      }
      .email-header {
        padding: 16px 14px 14px !important;
      }
      .email-header-slogan {
        font-size: 13px !important;
      }
      .email-body {
        padding: 22px 14px 30px !important;
      }
      /* Responsive Fluid Stacking Columns */
      .fluid-stack-col {
        display: block !important;
        width: 100% !important;
        max-width: 100% !important;
        text-align: center !important;
        padding-left: 0 !important;
        padding-right: 0 !important;
      }
      .fluid-stack-left {
        display: block !important;
        width: 100% !important;
        max-width: 100% !important;
        text-align: left !important;
        padding-left: 0 !important;
        padding-right: 0 !important;
        margin-bottom: 20px !important;
      }
      .fluid-stack-img {
        display: block !important;
        margin: 0 auto !important;
        max-width: 220px !important;
      }
      /* 3-Column Feature Cards Stacking */
      .feature-col {
        display: block !important;
        width: 100% !important;
        max-width: 100% !important;
        padding: 10px 0 !important;
        border-bottom: 1px solid #F3F4F6 !important;
      }
      .feature-col:last-child {
        border-bottom: none !important;
      }
      /* Order Meta Stacking */
      .meta-box-col {
        display: block !important;
        width: 100% !important;
        max-width: 100% !important;
        padding: 8px 0 !important;
        border-bottom: 1px solid #E5E7EB !important;
      }
      .meta-box-col:last-child {
        border-bottom: none !important;
      }
      /* OTP Digits scaling on small screens */
      .otp-digit-td {
        width: 38px !important;
        height: 44px !important;
        font-size: 20px !important;
        line-height: 44px !important;
      }
      .otp-digit-gap {
        width: 4px !important;
      }
      /* Stepper Stacking on small screens */
      .stepper-step {
        width: 25% !important;
        font-size: 9.5px !important;
      }
      /* Footer Stacking */
      .footer-stack-col {
        display: block !important;
        width: 100% !important;
        max-width: 100% !important;
        text-align: center !important;
        padding: 12px 0 !important;
      }
      .footer-divider-col {
        display: none !important;
      }
      .footer-help-table {
        margin: 0 auto !important;
      }
      .footer-store-badges {
        margin-top: 8px !important;
        text-align: center !important;
      }
    }
  </style>
</head>
<body style="margin: 0; padding: 0; background-color: #F4F6F5; -webkit-text-size-adjust: 100%; -ms-text-size-adjust: 100%;">
  <table role="presentation" width="100%" border="0" cellpadding="0" cellspacing="0" class="email-wrapper" style="background-color: #F4F6F5; width: 100% !important; margin: 0; padding: 24px 8px;">
    <tr>
      <td align="center" style="vertical-align: top; padding: 0;">
        
        <!--[if (gte mso 9)|(IE)]>
        <table align="center" border="0" cellspacing="0" cellpadding="0" width="600" style="width: 600px;">
        <tr>
        <td align="center" valign="top" width="600">
        <![endif]-->

        <table role="presentation" class="email-container" border="0" cellpadding="0" cellspacing="0" width="100%" style="max-width: 600px; width: 100%; background-color: #FFFFFF; border-radius: 20px; overflow: hidden; border: 1px solid #E5E7EB; box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05); margin: 0 auto;">
          
          <!-- Top Brand Header Bar -->
          <tr>
            <td style="padding: 0;">
              <table role="presentation" width="100%" border="0" cellpadding="0" cellspacing="0" class="email-header" style="background-color: #FFFFFF; border-bottom: 1px solid #F3F4F6; padding: 22px 28px 16px;">
                <tr>
                  <td align="left" style="vertical-align: middle;">
                    <a href="https://goeatone.com" target="_blank" style="text-decoration: none; display: inline-block;">
                      <img src="https://res.cloudinary.com/dqtjja88b/image/upload/v1791211128/logo_hdst3i.png" alt="GoEat" style="height: 36px; max-height: 36px; width: auto; display: block; border: 0;" />
                    </a>
                  </td>
                  <td align="right" style="vertical-align: middle;">
                    <span class="email-header-slogan" style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size: 15px; font-weight: 800; color: #133824; letter-spacing: -0.2px; white-space: nowrap;">
                      One App. Every Craving.
                    </span>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- Dynamic Email Content Body -->
          <tr>
            <td class="email-body" style="padding: 28px 28px 36px; background-color: #FFFFFF;">
              <%- body %>
            </td>
          </tr>

          <!-- Unified Dark Forest Green Responsive Footer -->
          <tr>
            <td style="background-color: #133824; color: #FFFFFF; padding: 28px 24px 22px;">
              <table role="presentation" width="100%" border="0" cellpadding="0" cellspacing="0">
                <tr>
                  <!-- Left: Need Help & Social Links -->
                  <td class="footer-stack-col" style="vertical-align: top; width: 50%; padding-right: 14px;">
                    <table role="presentation" cellpadding="0" cellspacing="0" class="footer-help-table">
                      <tr>
                        <td style="vertical-align: top; padding-right: 10px;">
                          <div style="width: 32px; height: 32px; border-radius: 50%; background-color: #FFFFFF; text-align: center; line-height: 32px; display: inline-block;">
                            <span style="font-size: 16px; color: #133824;">✉</span>
                          </div>
                        </td>
                        <td style="vertical-align: top;">
                          <div style="font-size: 13px; font-weight: 700; color: #FFFFFF; line-height: 1.2;">Need help?</div>
                          <div style="font-size: 11px; color: #A3C2B0; margin-top: 2px;">We're here for you.</div>
                          <div style="margin-top: 3px;">
                            <a href="mailto:Support@goeatone.com" style="color: #F59E0B; text-decoration: none; font-size: 11.5px; font-weight: 700;">
                              Support@goeatone.com
                            </a>
                          </div>
                        </td>
                      </tr>
                    </table>

                    <!-- Follow Us Row -->
                    <div style="margin-top: 16px;">
                      <span style="font-size: 11px; font-weight: 600; color: #FFFFFF; vertical-align: middle;">Follow us</span>
                      <img src="https://res.cloudinary.com/dqtjja88b/image/upload/v1791211923/go_eat_email/email_badge_socials.png" alt="Social Links" style="height: 18px; width: auto; vertical-align: middle; margin-left: 8px; display: inline-block; border: 0;" />
                    </div>
                  </td>

                  <!-- Vertical Separator Divider (Hidden on mobile stack) -->
                  <td class="footer-divider-col" style="width: 1px; background-color: #235237; padding: 0;"></td>

                  <!-- Right: App Download Badges -->
                  <td class="footer-stack-col" style="vertical-align: top; width: 50%; padding-left: 18px;">
                    <div style="font-size: 12px; font-weight: 700; color: #FFFFFF; margin-bottom: 8px;">
                      Download the Go Eat app
                    </div>
                    <div class="footer-store-badges">
                      <a href="https://play.google.com" target="_blank" style="text-decoration: none; display: inline-block; margin-right: 6px; margin-bottom: 6px;">
                        <img src="https://res.cloudinary.com/dqtjja88b/image/upload/v1791211919/go_eat_email/email_badge_google_play.png" alt="Get it on Google Play" style="height: 28px; width: auto; display: inline-block; border: 0;" />
                      </a>
                      <a href="https://apple.com" target="_blank" style="text-decoration: none; display: inline-block; margin-bottom: 6px;">
                        <img src="https://res.cloudinary.com/dqtjja88b/image/upload/v1791211921/go_eat_email/email_badge_app_store.png" alt="Download on App Store" style="height: 28px; width: auto; display: inline-block; border: 0;" />
                      </a>
                    </div>
                  </td>
                </tr>
              </table>

              <!-- Bottom Copyright & Account Notice -->
              <div style="margin-top: 24px; padding-top: 14px; border-top: 1px solid #1C482F; text-align: center;">
                <p style="margin: 0 0 4px; font-size: 11px; color: #A3C2B0;">
                  @ <%= typeof year !== 'undefined' ? year : 2026 %> GoEat. All rights reserved
                </p>
                <p style="margin: 0; font-size: 9.5px; color: #7B9B88;">
                  You received this email because you created an account with GoEat.
                </p>
              </div>
            </td>
          </tr>

        </table>

        <!--[if (gte mso 9)|(IE)]>
        </td>
        </tr>
        </table>
        <![endif]-->

      </td>
    </tr>
  </table>
</body>
</html>
