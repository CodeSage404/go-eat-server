<h2 style="color: #0F3725; margin-top: 0; font-weight: 800;">Order Confirmed</h2>
<p>Dear <strong><%= customerName %></strong>,</p>
<p>Your order <strong>#<%= orderId.toString().slice(-6).toUpperCase() %></strong> has been received and confirmed by the outlet.</p>

<div class="highlight-box" style="margin-top: 20px;">
  <h3 style="margin-top: 0; color: #0F3725; border-bottom: 1px solid #E5E7EB; padding-bottom: 8px;">Order Summary</h3>
  
  <table style="width: 100%; border-collapse: collapse; margin-bottom: 16px;">
    <% if (typeof items !== 'undefined' && items && items.length > 0) { %>
      <% items.forEach(function(itemObj) { 
           var fItem = itemObj.foodItem || itemObj;
           var qty = itemObj.quantity || 1;
           var price = itemObj.price || fItem.price || 0;
           var imgUrl = fItem.image || 'https://via.placeholder.com/150';
      %>
      <tr>
        <td style="padding: 10px 0; border-bottom: 1px solid #F3F4F6; width: 60px;">
          <img src="<%= imgUrl %>" style="width: 48px; height: 48px; border-radius: 24px; object-fit: cover; background-color: #E8F5E9; display: block;" alt="Food item">
        </td>
        <td style="padding: 10px; border-bottom: 1px solid #F3F4F6;">
          <div style="font-weight: 600; color: #111827; font-size: 15px;"><%= fItem.name || 'Item' %></div>
          <div style="color: #6B7280; font-size: 13px; margin-top: 2px;">Qty: <%= qty %></div>
        </td>
        <td style="padding: 10px 0; border-bottom: 1px solid #F3F4F6; text-align: right; font-weight: 600; color: #111827;">
          ₦<%= (price * qty).toLocaleString() %>
        </td>
      </tr>
      <% }); %>
    <% } %>
  </table>

  <table style="width: 100%; border-collapse: collapse; font-size: 15px;">
    <tr>
      <td style="padding: 8px 0; color: #4B5563;"><strong>Total Paid:</strong></td>
      <td style="padding: 8px 0; text-align: right; font-weight: bold; color: #0F3725; font-size: 18px;">₦<%= total.toLocaleString() %></td>
    </tr>
  </table>
</div>

<p style="color: #4B5563; margin-top: 24px;">You will receive another update as soon as the rider accepts the delivery dispatch request.</p>