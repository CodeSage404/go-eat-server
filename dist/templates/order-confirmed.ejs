<!-- Main Content Body (Clean, Spacious, Un-squashed) -->
<div class="email-content-padding" style="padding: 32px 30px; background-color: #FFFFFF; border-radius: 0;">

  <!-- Customer Greeting -->
  <div style="margin-bottom: 24px;">
    <h2 style="font-size: 18px; font-weight: 800; color: #111827; margin: 0 0 8px;">
      <%= typeof customerName !== 'undefined' && customerName ? customerName : 'Food lover' %>, we received your order.
    </h2>
    <p style="font-size: 13px; line-height: 1.6; color: #4B5563; margin: 0;">
      Your payment was successful and the kitchen has received your order. We'll notify you as soon as your courier starts heading your way!
    </p>
  </div>

  <!-- Delivery Information -->
  <div style="margin-bottom: 24px; border-bottom: 1px solid #F3F4F6; padding-bottom: 18px;">
    <div style="margin-bottom: 14px;">
      <div style="font-size: 11.5px; font-weight: 800; color: #111827; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 4px;">
        Delivery address:
      </div>
      <div style="font-size: 13.5px; color: #4B5563; line-height: 1.4;">
        <%= typeof deliveryAddress !== 'undefined' && deliveryAddress ? deliveryAddress : 'Customer Delivery Address' %>
      </div>
    </div>

    <div>
      <div style="font-size: 11.5px; font-weight: 800; color: #111827; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 4px;">
        Expected Delivery:
      </div>
      <div style="font-size: 13.5px; color: #4B5563; line-height: 1.4;">
        <%= typeof estimatedDelivery !== 'undefined' ? estimatedDelivery : '25-35 minutes' %> • <%= typeof orderDate !== 'undefined' && orderDate ? orderDate : (new Date().toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) + ' - ' + new Date().toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit' })) %>
      </div>
    </div>
  </div>

  <!-- Itemized Order Section -->
  <% 
    var curr = typeof currencySymbol !== 'undefined' ? currencySymbol : '£';
    var orderItems = (typeof items !== 'undefined' && items) ? items : [];
    var totalAmount = typeof total !== 'undefined' ? total : 0;
    var dFee = typeof deliveryFee !== 'undefined' ? deliveryFee : 2.50;
    var sFee = typeof serviceFee !== 'undefined' ? serviceFee : 1.50;
    var sTotal = typeof subtotal !== 'undefined' ? subtotal : Math.max(0, totalAmount - dFee - sFee);
  %>
  <div style="margin-bottom: 24px;">
    <div style="font-size: 12px; font-weight: 800; color: #111827; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 12px;">
      Your Order:
    </div>

    <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
      <% if (orderItems.length > 0) { %>
        <% orderItems.forEach(function(itemObj) { 
             var fItem = itemObj.foodItem || itemObj;
             var qty = itemObj.quantity || 1;
             var price = itemObj.price || fItem.price || 0;
             var name = fItem.name || itemObj.name || 'Delicious Meal';
             var outlet = itemObj.restaurantName || fItem.restaurantName || (typeof restaurantName !== 'undefined' ? restaurantName : 'GoEat Store');
             var img = fItem.image || itemObj.image || (typeof emailAssetsUrl !== 'undefined' ? emailAssetsUrl + '/welcome-friends.jpg' : '');
        %>
        <tr>
          <td style="padding: 12px 0; border-bottom: 1px solid #F3F4F6; vertical-align: middle;">
            <table role="presentation" cellpadding="0" cellspacing="0">
              <tr>
                <% if (img) { %>
                <td style="width: 50px; padding-right: 14px; vertical-align: middle;">
                  <img src="<%= img %>" alt="<%= name %>" style="width: 48px; height: 48px; border-radius: 0; object-fit: cover; display: block; border: 1px solid #E5E7EB;" />
                </td>
                <% } %>
                <td style="vertical-align: middle;">
                  <div style="font-size: 14px; font-weight: 700; color: #111827;"><%= name %></div>
                  <div style="font-size: 12px; color: #6B7280; margin-top: 2px;"><%= outlet %> • Qty: <%= qty %></div>
                </td>
              </tr>
            </table>
          </td>
          <td align="right" style="padding: 12px 0; border-bottom: 1px solid #F3F4F6; vertical-align: middle; font-size: 14px; font-weight: 800; color: #133824; white-space: nowrap;">
            <%= curr %><%= Number(price * qty).toFixed(2) %>
          </td>
        </tr>
        <% }); %>
      <% } else { %>
        <tr>
          <td colspan="2" style="padding: 12px 0; font-size: 13px; color: #6B7280;">Order Items</td>
        </tr>
      <% } %>
    </table>
  </div>

  <!-- Price Summary Table -->
  <div style="margin-bottom: 28px; padding-top: 8px;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
      <tr>
        <td style="padding: 6px 0; font-size: 13px; color: #6B7280;">Payment Method:</td>
        <td align="right" style="padding: 6px 0; font-size: 13px; font-weight: 600; color: #111827;">Credit Card / Stripe</td>
      </tr>
      <tr>
        <td style="padding: 6px 0; font-size: 13px; color: #6B7280;">Sub-total:</td>
        <td align="right" style="padding: 6px 0; font-size: 13px; font-weight: 600; color: #111827;"><%= curr %><%= Number(sTotal).toFixed(2) %></td>
      </tr>
      <tr>
        <td style="padding: 6px 0; font-size: 13px; color: #6B7280;">Delivery fee:</td>
        <td align="right" style="padding: 6px 0; font-size: 13px; font-weight: 600; color: #111827;"><%= curr %><%= Number(dFee).toFixed(2) %></td>
      </tr>
      <tr>
        <td style="padding: 6px 0; font-size: 13px; color: #6B7280;">Service fee:</td>
        <td align="right" style="padding: 6px 0; font-size: 13px; font-weight: 600; color: #111827;"><%= curr %><%= Number(sFee).toFixed(2) %></td>
      </tr>
      <tr>
        <td style="padding-top: 14px; font-size: 16px; font-weight: 800; color: #111827; border-top: 1px solid #E5E7EB;">Total:</td>
        <td align="right" style="padding-top: 14px; font-size: 22px; font-weight: 900; color: #133824; border-top: 1px solid #E5E7EB;"><%= curr %><%= Number(totalAmount).toFixed(2) %></td>
      </tr>
    </table>
  </div>

  <!-- Action CTA Button -->
  <div style="text-align: center; margin: 26px 0 22px;">
    <a href="https://goeatone.com" target="_blank" style="display: inline-block; background-color: #F59E0B; color: #133824 !important; text-decoration: none; font-weight: 900; font-size: 14.5px; padding: 15px 48px; border-radius: 999px; text-align: center; text-transform: uppercase; letter-spacing: 0.4px; box-shadow: 0 4px 16px rgba(245, 158, 11, 0.35);">
      Track Order Progress
    </a>
  </div>

  <!-- Cancellation & Support Notice -->
  <div style="text-align: center; padding-top: 16px; border-top: 1px solid #F3F4F6;">
    <p style="font-size: 12px; color: #9CA3AF; margin: 0; line-height: 1.5;">
      If you need to make changes or have questions about your order, sign in to your <a href="https://goeatone.com" style="color: #F59E0B; text-decoration: none; font-weight: 700;">GoEat Account</a> or contact our 24/7 support.
    </p>
  </div>

</div>
