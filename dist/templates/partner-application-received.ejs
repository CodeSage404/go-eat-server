<!-- Partner Application Received Hero Icon -->
<div style="text-align: center; margin: 10px 0 16px;">
  <div style="width: 72px; height: 72px; border-radius: 50%; background-color: #ECFDF5; border: 2px solid #A7F3D0; margin: 0 auto; text-align: center; line-height: 72px; font-size: 32px;">
    📋
  </div>
</div>

<!-- Title & Accent Bar -->
<div style="text-align: center;">
  <h1 style="margin: 0; font-size: 24px; font-weight: 800; color: #133824; letter-spacing: -0.3px;">
    Partner Application Received
  </h1>
  <div style="width: 38px; height: 3px; background-color: #F59E0B; border-radius: 2px; margin: 10px auto 18px;"></div>
</div>

<!-- Greeting & Message -->
<div style="text-align: center; max-width: 440px; margin: 0 auto 24px;">
  <p style="font-size: 14px; font-weight: 700; color: #1F2937; margin: 0 0 8px;">
    Hello <%= typeof ownerName !== 'undefined' && ownerName ? ownerName : 'Valued Partner' %>,
  </p>
  <p style="font-size: 13px; line-height: 1.6; color: #4B5563; margin: 0;">
    Thank you for applying to partner with GoEat for <strong><%= typeof businessName !== 'undefined' ? businessName : 'Your Outlet' %></strong>! We have received your merchant registration application.
  </p>
</div>

<!-- Outlet Summary Box -->
<div style="background-color: #F9FAFB; border: 1px solid #E5E7EB; border-radius: 18px; padding: 20px 22px; max-width: 480px; margin: 0 auto 24px;">
  <div style="font-size: 12px; font-weight: 800; color: #133824; margin-bottom: 12px; border-bottom: 1px solid #E5E7EB; padding-bottom: 8px;">
    Submitted Outlet Details
  </div>

  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="font-size: 13px;">
    <tr>
      <td style="padding: 6px 0; color: #6B7280; width: 120px;">Business Name:</td>
      <td style="padding: 6px 0; font-weight: 700; color: #111827;"><%= businessName %></td>
    </tr>
    <tr>
      <td style="padding: 6px 0; color: #6B7280;">Business Type:</td>
      <td style="padding: 6px 0; font-weight: 600; color: #111827; text-transform: capitalize;"><%= typeof businessType !== 'undefined' ? businessType : 'Restaurant' %></td>
    </tr>
    <tr>
      <td style="padding: 6px 0; color: #6B7280;">Street Address:</td>
      <td style="padding: 6px 0; font-weight: 600; color: #374151;"><%= businessAddress %></td>
    </tr>
    <tr>
      <td style="padding: 6px 0; color: #6B7280;">Contact Email:</td>
      <td style="padding: 6px 0; font-weight: 600; color: #111827;"><%= email %></td>
    </tr>
    <tr>
      <td style="padding: 6px 0; color: #6B7280;">Phone Number:</td>
      <td style="padding: 6px 0; font-weight: 600; color: #111827;"><%= phoneNumber %></td>
    </tr>
  </table>
</div>

<!-- What Happens Next Section -->
<div style="background-color: #ECFDF5; border: 1px solid #A7F3D0; border-radius: 16px; padding: 16px 20px; max-width: 480px; margin: 0 auto 24px; text-align: left;">
  <div style="font-size: 12.5px; font-weight: 800; color: #064E3B; margin-bottom: 4px;">
    What happens next?
  </div>
  <p style="font-size: 12px; color: #047857; line-height: 1.5; margin: 0;">
    You can log into the <strong>Go-Eat Partner App</strong> right away using your email to set up your digital menu, working hours, and dishes! Our team will verify your compliance documentation to activate live order dispatch.
  </p>
</div>
