<!-- Main Content Body (Clean, Spacious, Un-squashed) -->
<div class="email-content-padding" style="padding: 32px 30px; background-color: #FFFFFF; border-radius: 0;">

  <!-- Greeting & Intro -->
  <div style="margin-bottom: 24px;">
    <h2 style="font-size: 18px; font-weight: 800; color: #111827; margin: 0 0 8px;">
      Hello, <%= typeof userName !== 'undefined' && userName ? userName : 'Valued Partner' %>! 💼
    </h2>
    <p style="font-size: 13px; line-height: 1.6; color: #4B5563; margin: 0;">
      Your wallet withdrawal request has been submitted and approved. Below is your official transaction receipt for your records.
    </p>
  </div>

<!-- Transaction Summary Card -->
<div style="border: 1px solid #E5E7EB; border-radius: 0; padding: 20px; background-color: #FFFFFF; margin-bottom: 22px;">
  <div style="font-size: 12px; font-weight: 800; color: #133824; margin-bottom: 12px; border-bottom: 1px solid #F3F4F6; padding-bottom: 8px;">
    Transaction Details
  </div>

  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin-bottom: 14px; font-size: 13px;">
    <tr>
      <td style="padding: 8px 0; border-bottom: 1px solid #F3F4F6; color: #6B7280;">Transaction Reference</td>
      <td style="padding: 8px 0; border-bottom: 1px solid #F3F4F6; text-align: right; font-weight: 700; color: #111827; font-family: -apple-system, BlinkMacSystemFont, monospace;">
        #<%= typeof reference !== 'undefined' ? reference : 'WDR-000000' %>
      </td>
    </tr>
    <tr>
      <td style="padding: 8px 0; border-bottom: 1px solid #F3F4F6; color: #6B7280;">Date & Time</td>
      <td style="padding: 8px 0; border-bottom: 1px solid #F3F4F6; text-align: right; font-weight: 600; color: #111827;">
        <%= typeof date !== 'undefined' ? date : new Date().toLocaleString() %>
      </td>
    </tr>
    <tr>
      <td style="padding: 8px 0; border-bottom: 1px solid #F3F4F6; color: #6B7280;">Destination Bank</td>
      <td style="padding: 8px 0; border-bottom: 1px solid #F3F4F6; text-align: right; font-weight: 600; color: #111827;">
        <%= typeof bankName !== 'undefined' ? bankName : 'Verified Bank' %>
      </td>
    </tr>
    <tr>
      <td style="padding: 8px 0; border-bottom: 1px solid #F3F4F6; color: #6B7280;">Account Number</td>
      <td style="padding: 8px 0; border-bottom: 1px solid #F3F4F6; text-align: right; font-weight: 600; color: #111827;">
        •••• <%= typeof accountNumber !== 'undefined' ? String(accountNumber).slice(-4) : '••••' %>
      </td>
    </tr>
    <tr>
      <td style="padding: 8px 0; border-bottom: 1px solid #F3F4F6; color: #6B7280;">Account Name</td>
      <td style="padding: 8px 0; border-bottom: 1px solid #F3F4F6; text-align: right; font-weight: 600; color: #111827;">
        <%= typeof accountName !== 'undefined' ? accountName : 'Partner' %>
      </td>
    </tr>
    <tr>
      <td style="padding: 8px 0; border-bottom: 1px solid #F3F4F6; color: #6B7280;">Status</td>
      <td style="padding: 8px 0; border-bottom: 1px solid #F3F4F6; text-align: right; font-weight: 700; color: #059669;">
        <%= typeof status !== 'undefined' ? status : 'Processing' %>
      </td>
    </tr>
  </table>

  <!-- Amount Withdrawn -->
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin-top: 10px;">
    <tr>
      <td style="font-size: 13.5px; font-weight: 700; color: #374151;">Amount Withdrawn:</td>
      <td align="right" style="font-size: 20px; font-weight: 800; color: #133824;">
        <% 
          var curr = typeof currencySymbol !== 'undefined' ? currencySymbol : (typeof currency !== 'undefined' ? currency : '₦');
          var amt = typeof amount !== 'undefined' ? amount : '0';
          var isNumeric = !isNaN(Number(String(amt).replace(/[^0-9.-]+/g, "")));
        %>
        <%= String(amt).startsWith(curr) ? '' : curr %><%= isNumeric ? Number(String(amt).replace(/[^0-9.-]+/g, "")).toLocaleString() : amt %>
      </td>
    </tr>
  </table>
</div>

<p style="color: #6B7280; font-size: 12px; line-height: 1.6; text-align: center; margin: 0 auto; max-width: 460px;">
  Funds are typically credited to your verified bank account within a few minutes, subject to inter-bank clearing networks.
</p>
