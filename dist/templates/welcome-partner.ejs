<%
  var bName = (typeof businessName !== 'undefined' && businessName) ? businessName : ((typeof restaurantName !== 'undefined' && restaurantName) ? restaurantName : ((typeof partnerName !== 'undefined' && partnerName) ? partnerName : 'Partner'));
  var uEmail = (typeof email !== 'undefined' && email) ? email : (typeof username !== 'undefined' ? username : 'partner@business.com');
  var bPhone = (typeof phone !== 'undefined' && phone) ? phone : ((typeof phoneNumber !== 'undefined' && phoneNumber) ? phoneNumber : '');
  var bType = (typeof businessType !== 'undefined' && businessType) ? businessType : ((typeof outletType !== 'undefined' && outletType) ? outletType : 'Restaurant');
  var bAddress = (typeof businessAddress !== 'undefined' && businessAddress) ? businessAddress : ((typeof address !== 'undefined' && address) ? (typeof address === 'object' ? (address.street || address.city || 'Registered Store Location') : address) : 'Registered Store Location');
  var isFounding = (typeof isFoundingPartner !== 'undefined') ? isFoundingPartner : true;
  var logoUrl = (typeof logoUrl !== 'undefined' && logoUrl) ? logoUrl : 'https://go-eat-webapp.vercel.app/images/goeatone_logo_dark.jpg';
  var badgeUrl = (typeof badgeUrl !== 'undefined' && badgeUrl) ? badgeUrl : 'https://go-eat-webapp.vercel.app/images/founding_partner_badge.jpg';
  var dashboardUrl = (typeof loginUrl !== 'undefined' && loginUrl) ? loginUrl : 'https://go-eat-webapp.vercel.app/partners/login';
%>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="color-scheme" content="light">
  <title>GoEatOne – <%= isFounding ? 'Founding Partner Onboarding' : 'Partner Onboarding' %></title>
  <style>
    body { margin:0; padding:0; background:#f3f6f3; font-family:Arial,Helvetica,sans-serif; -webkit-text-size-adjust:100%; }
    table { border-collapse:collapse; }
    img { border:0; display:block; height:auto; }
    p { margin:0 0 15px; }
    @media screen and (max-width:640px) {
      .container { width:100%!important; }
      .pad { padding:26px 20px!important; }
      .hero-title { font-size:28px!important; }
      .badge-img { width:155px!important; }
      .logo-img { width:100%!important; max-width:100%!important; }
      .twocol { display:block!important; width:100%!important; }
      .mobile-center { text-align:center!important; }
    }
  </style>
</head>
<body style="margin:0;padding:0;background:#f3f6f3;font-family:Arial,Helvetica,sans-serif;color:#173c2c;">
<div style="display:none;max-height:0;overflow:hidden;opacity:0;">Congratulations! Your outlet has been officially approved and onboarded to the GoEatOne Partner Network.</div>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f3f6f3">
  <tr>
    <td align="center" style="padding:32px 12px">
      <table role="presentation" class="container" width="600" cellpadding="0" cellspacing="0" style="width:600px;max-width:600px;background:#ffffff;border-radius:16px;overflow:hidden;box-shadow:0 4px 20px rgba(0,0,0,0.06);">
        <!-- Top Dark Banner with GoEatOne Logo -->
        <tr>
          <td align="center" style="background:#004024;padding:0;line-height:0;font-size:0">
            <img class="logo-img" src="<%= logoUrl %>" alt="GoEatOne – One App. Every Craving." width="600" style="display:block;width:100%;max-width:600px;height:auto;border:0">
          </td>
        </tr>
        <!-- Golden Accent Stripe -->
        <tr>
          <td style="height:6px;background:#ffc629;font-size:0;line-height:0">&nbsp;</td>
        </tr>
        <!-- Headline & Intro -->
        <tr>
          <td class="pad" style="padding:36px 40px 18px">
            <p style="margin:0 0 9px;color:#997000;font-size:12px;letter-spacing:2px;font-weight:bold;text-transform:uppercase">
              GoEatOne · <%= isFounding ? 'Founding Partner Onboarding' : 'Business Partner Onboarding' %>
            </p>
            <h1 class="hero-title" style="margin:0 0 16px;font-size:32px;line-height:1.2;color:#06462f;letter-spacing:-0.6px">
              We’ve given your business a head start.
            </h1>
            <p style="font-size:15px;line-height:1.7;color:#40564b">Dear <strong><%= bName %></strong>,</p>
            <p style="font-size:14.5px;line-height:1.7;color:#40564b">
              Congratulations! Your merchant registration and documentation have been reviewed and approved by our administration team. Your business is now officially onboarded to the <strong>GoEatOne Partner Network</strong>!
            </p>
            <p style="font-size:14.5px;line-height:1.7;color:#40564b">
              To give your kitchen and store the strongest momentum, your verified storefront profile has been initialized and is ready for customer ordering, dish curation, and priority delivery dispatch.
            </p>
          </td>
        </tr>

        <!-- Onboarded Business Details Box (No Credentials, Pure Business Details) -->
        <tr>
          <td class="pad" style="padding:4px 40px 22px">
            <table role="presentation" width="100%" style="background:#f5f8f5;border:1px solid #deebe3;border-left:4px solid #ffc629;border-radius:12px">
              <tr>
                <td style="padding:22px 24px">
                  <h2 style="margin:0 0 6px;color:#06462f;font-size:18px;font-weight:bold">Your Onboarded Business Profile</h2>
                  <p style="font-size:13px;line-height:1.55;color:#40564b;margin:0 0 16px">Below are your verified outlet registration details on the GoEatOne platform:</p>
                  
                  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="font-size:13px;">
                    <tr>
                      <td style="padding:7px 0;color:#557064;width:140px;font-weight:500;">Business Name:</td>
                      <td style="padding:7px 0;font-weight:bold;color:#073f2d;"><%= bName %></td>
                    </tr>
                    <tr>
                      <td style="padding:7px 0;color:#557064;font-weight:500;">Category / Type:</td>
                      <td style="padding:7px 0;font-weight:600;color:#073f2d;text-transform:capitalize;"><%= bType %></td>
                    </tr>
                    <tr>
                      <td style="padding:7px 0;color:#557064;font-weight:500;">Registered Address:</td>
                      <td style="padding:7px 0;font-weight:600;color:#073f2d;"><%= bAddress %></td>
                    </tr>
                    <tr>
                      <td style="padding:7px 0;color:#557064;font-weight:500;">Registered Email:</td>
                      <td style="padding:7px 0;font-weight:600;color:#073f2d;"><%= uEmail %></td>
                    </tr>
                    <% if (bPhone) { %>
                    <tr>
                      <td style="padding:7px 0;color:#557064;font-weight:500;">Contact Phone:</td>
                      <td style="padding:7px 0;font-weight:600;color:#073f2d;"><%= bPhone %></td>
                    </tr>
                    <% } %>
                    <tr>
                      <td style="padding:7px 0;color:#557064;font-weight:500;">Onboarding Status:</td>
                      <td style="padding:7px 0;font-weight:bold;color:#00753a;">
                        <span style="display:inline-block;width:8px;height:8px;background:#00a854;border-radius:50%;margin-right:6px;"></span>Active &amp; Verified Partner
                      </td>
                    </tr>
                    <tr>
                      <td style="padding:7px 0;color:#557064;font-weight:500;">Commercial Tier:</td>
                      <td style="padding:7px 0;font-weight:bold;color:#997000;">
                        <%= isFounding ? 'Founding Partner (3 Months 0% Commission)' : 'Standard Marketplace Tier' %>
                      </td>
                    </tr>
                  </table>

                  <div style="margin-top:16px;padding-top:12px;border-top:1px solid #deebe3;font-size:12px;color:#54675b;line-height:1.55">
                    You can access your partner dashboard using the sign-in credentials provided in your initial registration email. If you need to reset your password at any time, you can do so directly on the login screen.
                  </div>
                </td>
              </tr>
            </table>
          </td>
        </tr>

        <% if (isFounding) { %>
        <!-- Founding Partner Badge -->
        <tr>
          <td align="center" class="pad" style="padding:8px 40px 16px">
            <img class="badge-img" src="<%= badgeUrl %>" alt="GoEatOne Founding Partner" width="176" style="width:176px;max-width:65%;height:auto;border:0;">
          </td>
        </tr>
        <!-- Founding Partner Offer Banner -->
        <tr>
          <td class="pad" style="padding:0 40px 24px">
            <table role="presentation" width="100%" style="background:#004b32;border-radius:12px">
              <tr>
                <td style="padding:26px 22px;text-align:center">
                  <div style="color:#ffd34b;font-size:12px;font-weight:bold;letter-spacing:1.5px;text-transform:uppercase">Founding Partner Privilege</div>
                  <div style="font-size:34px;font-weight:800;line-height:1.15;color:#fff;margin:10px 0">3 MONTHS<br><span style="color:#ffd34b">0% COMMISSION</span></div>
                  <div style="font-size:14px;line-height:1.5;color:#fff">on all eligible marketplace sales, giving your revenue maximum growth</div>
                </td>
              </tr>
            </table>
          </td>
        </tr>
        <% } %>

        <!-- Getting Started & Dashboard Access -->
        <tr>
          <td class="pad" style="padding:1px 40px 30px">
            <h2 style="font-size:19px;color:#06462f;margin:0 0 12px">Start Receiving Orders &amp; Managing Your Kitchen</h2>
            <p style="color:#40564b;font-size:14px;line-height:1.7">
              Your partner outlet is fully operational. Open the <strong>GoEatOne Partner Hub</strong> to review your food catalog, adjust pricing, specify preparation times, set your daily operating hours, and link your payout bank account.
            </p>

            <div style="text-align:center;margin:24px 0 20px;">
              <a href="<%= dashboardUrl %>" target="_blank" style="display:inline-block;padding:13px 34px;background:#06462f;color:#ffffff;font-size:14px;font-weight:bold;text-decoration:none;border-radius:30px;box-shadow:0 4px 14px rgba(6,70,47,0.25);">
                Open Partner Dashboard &rarr;
              </a>
            </div>

            <p style="font-size:14px;line-height:1.65;color:#40564b;margin:22px 0 0">
              Welcome to the family. We look forward to scaling your business with you!<br><br>
              Warm regards,<br>
              <strong>GoEatOne Partner Onboarding Team</strong>
            </p>
          </td>
        </tr>

        <!-- Footer -->
        <tr>
          <td style="background:#06462f;padding:28px 36px;text-align:center">
            <div style="font-size:17px;font-weight:bold;color:#fff">GoEatOne</div>
            <div style="font-size:12px;color:#f9cd4e;margin-top:6px">One App. Every Craving. Delivered Fresh &amp; Fast.</div>
            <div style="color:#e4eee7;font-size:12.5px;margin-top:12px">
              <a href="https://goeatone.com" style="color:#ffc629;text-decoration:none;margin:0 8px;font-weight:600">Website</a> •
              <a href="https://goeatone.com/privacy-policy" style="color:#ffc629;text-decoration:none;margin:0 8px;font-weight:600">Privacy Policy</a> •
              <a href="https://goeatone.com/terms" style="color:#ffc629;text-decoration:none;margin:0 8px;font-weight:600">Terms</a> •
              <a href="mailto:support@goeatone.com" style="color:#ffc629;text-decoration:none;margin:0 8px;font-weight:600">Support</a>
            </div>
            <div style="color:#b9d1c3;font-size:11px;line-height:1.6;margin-top:15px">
              &copy; <%= typeof year !== 'undefined' ? year : 2026 %> GoEatOne. All rights reserved.<br>
              <strong style="color:#d4e8dc">FOREMADE GLOBAL</strong><br>
              71-75 Shelton Street, Covent Garden, London, WC2H 9JQ, United Kingdom
            </div>
          </td>
        </tr>
      </table>
    </td>
  </tr>
</table>
</body>
</html>
