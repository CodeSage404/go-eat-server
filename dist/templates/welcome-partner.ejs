<div class="email-content-padding" style="padding: 36px 30px 28px; background-color: #FFFFFF; text-align: center; border-radius: 0;">

  <!-- Main Title & Subtitle (Bold, Normal Sentence Casing) -->
  <h1 class="brand-heading" style="font-family: 'Bricolage Grotesque', 'Poppins', -apple-system, sans-serif; font-size: 28px; line-height: 1.25; font-weight: 800; color: #111827; letter-spacing: -0.4px; margin: 0 auto 12px; text-align: center;">
    Welcome to GoEatOne Partners
  </h1>

  <p style="font-family: 'Poppins', sans-serif; font-size: 14.5px; line-height: 1.6; color: #4B5563; margin: 0 auto 28px; max-width: 480px; text-align: center;">
    Dear <strong><%= typeof partnerName !== 'undefined' && partnerName ? partnerName : (typeof ownerName !== 'undefined' && ownerName ? ownerName : 'Partner') %></strong>, congratulations! Your merchant partner account for <strong style="color: #111827;"><%= typeof restaurantName !== 'undefined' && restaurantName ? restaurantName : (typeof businessName !== 'undefined' && businessName ? businessName : 'your store') %></strong> is now active on the GoEatOne platform.
  </p>

  <!-- High-Contrast Vendor Login Credentials Box -->
  <div style="background-color: #F9FAFB; border: 1.5px solid #E5E7EB; border-radius: 0; padding: 22px 24px 20px; max-width: 460px; margin: 0 auto 28px; text-align: left;">
    <div style="font-family: 'Bricolage Grotesque', 'Poppins', sans-serif; font-size: 13px; font-weight: 800; color: #133824; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 14px; border-bottom: 1px solid #E5E7EB; padding-bottom: 8px;">
      Your Merchant Login Credentials
    </div>

    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="font-size: 13.5px; font-family: 'Poppins', sans-serif;">
      <tr>
        <td style="padding: 8px 0; color: #6B7280; width: 140px; font-weight: 600;">Email / Username:</td>
        <td style="padding: 8px 0; font-weight: 700; color: #111827; font-family: -apple-system, BlinkMacSystemFont, monospace;">
          <%= typeof email !== 'undefined' && email ? email : 'partner@business.com' %>
        </td>
      </tr>
      <tr>
        <td style="padding: 8px 0; color: #6B7280; font-weight: 600;">Temporary Password:</td>
        <td style="padding: 8px 0; font-weight: 800; color: #133824; font-family: -apple-system, BlinkMacSystemFont, monospace; background-color: #F1FBF4; padding-left: 8px; border-left: 3px solid #10B981;">
          <%= typeof password !== 'undefined' && password ? password : '••••••••••••' %>
        </td>
      </tr>
    </table>

    <div style="margin-top: 14px; padding-top: 12px; border-top: 1px dashed #E5E7EB; font-size: 12px; color: #4B5563; line-height: 1.55;">
      💡 <strong>Next Step:</strong> Log in to the <strong>GoEatOne Partner App</strong> to verify your store details, upload your menu items, and start accepting online orders.
    </div>
  </div>

  <!-- Primary Yellow Pill CTA Button -->
  <div style="margin: 10px 0 24px; text-align: center;">
    <a 
      href="<%= typeof loginUrl !== 'undefined' && loginUrl ? loginUrl : 'https://goeatone.com/partners/login' %>" 
      target="_blank" 
      style="display: inline-block; background-color: #F59E0B; color: #133824 !important; text-decoration: none; font-family: 'Poppins', sans-serif; font-weight: 800; font-size: 14px; padding: 14px 44px; border-radius: 999px; text-align: center; text-transform: uppercase; letter-spacing: 0.5px; box-shadow: 0 4px 16px rgba(245, 158, 11, 0.35);"
    >
      Log In to Partner Portal
    </a>
    <div style="margin-top: 12px;">
      <a href="https://goeatone.com/partners/login" target="_blank" style="font-family: 'Poppins', sans-serif; font-size: 12px; color: #059669; text-decoration: underline; font-weight: 600;">
        Open Web App Dashboard &rarr;
      </a>
    </div>
  </div>

  <!-- Security Note -->
  <p style="font-family: 'Poppins', sans-serif; font-size: 12px; color: #9CA3AF; margin: 0 auto; max-width: 420px; line-height: 1.5;">
    For your store security, please update your temporary password after logging in for the first time.
  </p>

</div>
