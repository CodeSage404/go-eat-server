<!DOCTYPE html>
<html lang="en" xmlns="http://www.w3.org/1999/xhtml" xmlns:v="urn:schemas-microsoft-com:vml" xmlns:o="urn:schemas-microsoft-com:office:office">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="x-apple-disable-message-reformatting">
  <meta name="format-detection" content="telephone=no,address=no,email=no,date=no,url=no">
  <title>GoEatOne</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@400;500;600;700;800&family=Poppins:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
  <!--[if mso]>
  <style type="text/css">
    body, table, td, h1, h2, h3, p, a, span { font-family: -apple-system, BlinkMacSystemFont, Arial, sans-serif !important; }
  </style>
  <![endif]-->
  <style type="text/css">
    html, body {
      margin: 0 auto !important;
      padding: 0 !important;
      height: 100% !important;
      width: 100% !important;
      background-color: #F4F6F5;
      font-family: 'Poppins', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
      color: #1F2937;
      -webkit-font-smoothing: antialiased;
      -ms-text-size-adjust: 100%;
      -webkit-text-size-adjust: 100%;
    }
    table, td {
      mso-table-lspace: 0pt !important;
      mso-table-rspace: 0pt !important;
      border-collapse: collapse !important;
    }
    img {
      -ms-interpolation-mode: bicubic;
      border: 0;
      height: auto;
      line-height: 100%;
      outline: none;
      text-decoration: none;
      max-width: 100%;
    }
    h1, h2, h3, h4, .brand-heading {
      font-family: 'Bricolage Grotesque', 'Poppins', -apple-system, BlinkMacSystemFont, sans-serif !important;
    }
    /* Mobile-Specific Responsive Overrides */
    @media only screen and (max-width: 600px) {
      .email-wrapper {
        padding: 0 !important;
      }
      .email-container {
        width: 100% !important;
        max-width: 100% !important;
        border-radius: 0 !important;
        border: none !important;
      }
      .email-body {
        padding: 24px 20px 30px !important;
      }
      .welcome-content {
        padding: 24px 16px 30px !important;
      }
      .welcome-main-title {
        font-size: 26px !important;
        margin-bottom: 12px !important;
      }
      .welcome-intro-text {
        font-size: 14px !important;
        line-height: 1.6 !important;
        margin-bottom: 26px !important;
      }
      .welcome-section-heading {
        font-size: 21px !important;
        margin-bottom: 24px !important;
      }
      /* On mobile: big images reaching the far ends, stacked above text */
      .feature-row {
        margin-bottom: 34px !important;
        display: block !important;
        width: 100% !important;
      }
      .feature-cell-img {
        display: block !important;
        width: 100% !important;
        text-align: center !important;
        padding: 0 0 16px 0 !important;
      }
      .feature-cell-text {
        display: block !important;
        width: 100% !important;
        text-align: center !important;
        padding: 0 4px !important;
      }
      .feature-img {
        width: 100% !important;
        max-width: 100% !important;
        height: auto !important;
        display: block !important;
        margin: 0 auto !important;
        border-radius: 8px !important;
      }
      .feature-title {
        font-size: 18px !important;
        margin-bottom: 6px !important;
        text-align: center !important;
      }
      .feature-desc {
        font-size: 13.5px !important;
        line-height: 1.55 !important;
        text-align: center !important;
      }
      .welcome-cta-btn {
        font-size: 14px !important;
        padding: 14px 42px !important;
      }
      /* General content padding */
      .email-content-padding {
        padding: 24px 16px !important;
      }
      /* OTP Digits scaling on small screens */
      .otp-digit-td {
        width: 44px !important;
        height: 56px !important;
        font-size: 26px !important;
        line-height: 56px !important;
        border-radius: 10px !important;
      }
      .otp-digit-gap {
        width: 6px !important;
      }
      .river-flow-stripe {
        height: 28px !important;
      }
      .river-flow-stripe img {
        height: 28px !important;
      }
    }
    /* Clean Email Canvas: Keep email container pristine across all email clients */
    @media (prefers-color-scheme: dark) {
      body, .email-wrapper { background-color: #121815 !important; }
      .email-container { background-color: #FFFFFF !important; }
      .email-body { background-color: #FFFFFF !important; }
    }
  </style>
</head>
<body style="margin: 0; padding: 0; background-color: #F4F6F5; -webkit-text-size-adjust: 100%; -ms-text-size-adjust: 100%;">
  <%
    var assetsBase = (typeof emailAssetsUrl !== 'undefined' && emailAssetsUrl) ? emailAssetsUrl : '';
    var stripeAsset = assetsBase ? (assetsBase + '/stripe.png') : 'cid:goeat_stripe';
    var logoAsset = assetsBase ? (assetsBase + '/logo.png') : 'cid:goeat_logo';
  %>
  <table role="presentation" width="100%" border="0" cellpadding="0" cellspacing="0" class="email-wrapper" style="background-color: #F4F6F5; width: 100% !important; margin: 0; padding: 24px 8px;">
    <tr>
      <td align="center" style="vertical-align: top; padding: 0;">
        
        <!--[if (gte mso 9)|(IE)]>
        <table align="center" border="0" cellspacing="0" cellpadding="0" width="600" style="width: 600px;">
        <tr>
        <td align="center" valign="top" width="600">
        <![endif]-->

        <table role="presentation" class="email-container" border="0" cellpadding="0" cellspacing="0" width="100%" style="max-width: 600px; width: 600px; background-color: #FFFFFF; border-radius: 16px; overflow: hidden; border: 1px solid #E5E7EB; box-shadow: 0 4px 20px rgba(0, 0, 0, 0.06); margin: 0 auto;">
          
          <!-- Master Header Banner: Dark Green with GoEatOne Logo -->
          <tr>
            <td align="center" style="padding: 0; background-color: #004024; line-height: 0; font-size: 0;">
              <a href="https://goeatone.com" target="_blank" style="text-decoration: none; display: block;">
                <img 
                  class="logo-img"
                  src="<%= (typeof logoUrl !== 'undefined' && logoUrl) ? logoUrl : 'https://go-eat-webapp.vercel.app/images/goeatone_logo_dark.jpg' %>" 
                  alt="GoEatOne – One App. Every Craving." 
                  width="600" 
                  style="width: 100%; max-width: 600px; height: auto; display: block; margin: 0 auto; border: 0;" 
                />
              </a>
            </td>
          </tr>
          <!-- Golden Accent Stripe -->
          <tr>
            <td style="height: 6px; background-color: #ffc629; font-size: 0; line-height: 0;">&nbsp;</td>
          </tr>

          <% if (typeof heroTitle !== 'undefined' && heroTitle && (typeof hideHeaderTitle === 'undefined' || !hideHeaderTitle)) { %>
          <!-- Master Title Section -->
          <tr>
            <td style="padding: 34px 40px 10px; background-color: #FFFFFF; text-align: center;">
              <% if (typeof heroSubtitle !== 'undefined' && heroSubtitle) { %>
              <div style="font-family: Arial, Helvetica, sans-serif; font-size: 11px; font-weight: bold; color: #997000; letter-spacing: 2px; text-transform: uppercase; margin-bottom: 8px;">
                <%= heroSubtitle %>
              </div>
              <% } %>
              <h1 class="brand-heading" style="font-family: Arial, Helvetica, sans-serif; font-size: 28px; line-height: 1.25; font-weight: 800; color: #06462f; margin: 0; text-align: center; letter-spacing: -0.5px;">
                <%= heroTitle %>
              </h1>
            </td>
          </tr>
          <% } %>

          <!-- Dynamic Email Content Body (Generous 40px side margins) -->
          <tr>
            <td class="email-body" style="padding: 32px 40px 38px; background-color: #FFFFFF; border-radius: 0; font-family: Arial, Helvetica, sans-serif;">
              <%- body %>
            </td>
          </tr>

          <!-- Master Clean Editorial Footer Component -->
          <tr>
            <td style="background-color: #002d1a; padding: 32px 40px; text-align: center; color: #b7cebf; font-size: 12px; line-height: 1.7; font-family: Arial, Helvetica, sans-serif;">
              <p style="margin: 0 0 6px; font-weight: bold; color: #ffffff; font-size: 14px;">GoEatOne</p>
              <p style="margin: 0 0 12px; color: #a3c2b1;">One App. Every Craving. Delivered Fresh &amp; Fast.</p>
              <p style="margin: 0 0 14px;">
                <a href="https://goeatone.com" style="color: #ffc629; text-decoration: none; margin: 0 8px; font-weight: 600;">Website</a> •
                <a href="https://goeatone.com/privacy-policy" style="color: #ffc629; text-decoration: none; margin: 0 8px; font-weight: 600;">Privacy Policy</a> •
                <a href="https://goeatone.com/terms" style="color: #ffc629; text-decoration: none; margin: 0 8px; font-weight: 600;">Terms</a> •
                <a href="mailto:support@goeatone.com" style="color: #ffc629; text-decoration: none; margin: 0 8px; font-weight: 600;">Support</a>
              </p>
              <p style="margin: 0; color: #789987; font-size: 11px;">
                © <%= typeof year !== 'undefined' ? year : 2026 %> GoEatOne Limited. All rights reserved.<br />
                London, United Kingdom &bull; Lagos, Nigeria
              </p>
            </td>
          </tr>

        </table>

        <!--[if (gte mso 9)|(IE)]>
        </td>
        </tr>
        </table>
        <![endif]-->

      </td>
    </tr>
  </table>
</body>
</html>