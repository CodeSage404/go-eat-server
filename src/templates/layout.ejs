<!DOCTYPE html>
<html lang="en" xmlns="http://www.w3.org/1999/xhtml" xmlns:v="urn:schemas-microsoft-com:vml" xmlns:o="urn:schemas-microsoft-com:office:office">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="x-apple-disable-message-reformatting">
  <meta name="format-detection" content="telephone=no,address=no,email=no,date=no,url=no">
  <title>GoEatOne</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@400;500;600;700;800&family=Poppins:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
  <!--[if mso]>
  <style type="text/css">
    body, table, td, h1, h2, h3, p, a, span { font-family: -apple-system, BlinkMacSystemFont, Arial, sans-serif !important; }
  </style>
  <![endif]-->
  <style type="text/css">
    html, body {
      margin: 0 auto !important;
      padding: 0 !important;
      height: 100% !important;
      width: 100% !important;
      background-color: #F4F6F5;
      font-family: 'Poppins', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
      color: #1F2937;
      -webkit-font-smoothing: antialiased;
      -ms-text-size-adjust: 100%;
      -webkit-text-size-adjust: 100%;
    }
    table, td {
      mso-table-lspace: 0pt !important;
      mso-table-rspace: 0pt !important;
      border-collapse: collapse !important;
    }
    img {
      -ms-interpolation-mode: bicubic;
      border: 0;
      height: auto;
      line-height: 100%;
      outline: none;
      text-decoration: none;
      max-width: 100%;
    }
    h1, h2, h3, h4, .brand-heading {
      font-family: 'Bricolage Grotesque', 'Poppins', -apple-system, BlinkMacSystemFont, sans-serif !important;
    }
    /* Mobile-Specific Responsive Overrides: Big images reaching far ends, image first */
    @media only screen and (max-width: 600px) {
      .email-wrapper {
        padding: 0 !important;
      }
      .email-container {
        width: 100% !important;
        max-width: 100% !important;
        border-radius: 0 !important;
        border: none !important;
      }
      .welcome-content {
        padding: 24px 16px 30px !important;
      }
      .welcome-main-title {
        font-size: 26px !important;
        margin-bottom: 12px !important;
      }
      .welcome-intro-text {
        font-size: 14px !important;
        line-height: 1.6 !important;
        margin-bottom: 26px !important;
      }
      .welcome-section-heading {
        font-size: 21px !important;
        margin-bottom: 24px !important;
      }
      /* On mobile: big images reaching the far ends, stacked above text */
      .feature-row {
        margin-bottom: 34px !important;
        display: block !important;
        width: 100% !important;
      }
      .feature-cell-img {
        display: block !important;
        width: 100% !important;
        text-align: center !important;
        padding: 0 0 16px 0 !important;
      }
      .feature-cell-text {
        display: block !important;
        width: 100% !important;
        text-align: center !important;
        padding: 0 4px !important;
      }
      .feature-img {
        width: 100% !important;
        max-width: 100% !important;
        height: auto !important;
        display: block !important;
        margin: 0 auto !important;
        border-radius: 8px !important;
      }
      .feature-title {
        font-size: 18px !important;
        margin-bottom: 6px !important;
        text-align: center !important;
      }
      .feature-desc {
        font-size: 13.5px !important;
        line-height: 1.55 !important;
        text-align: center !important;
      }
      .welcome-cta-btn {
        font-size: 14px !important;
        padding: 14px 42px !important;
      }
      /* General content padding */
      .email-content-padding {
        padding: 24px 16px !important;
      }
      /* OTP Digits scaling on small screens */
      .otp-digit-td {
        width: 42px !important;
        height: 52px !important;
        font-size: 24px !important;
        line-height: 52px !important;
      }
      .otp-digit-gap {
        width: 4px !important;
      }
      .river-flow-stripe {
        height: 28px !important;
      }
      .river-flow-stripe img {
        height: 28px !important;
      }
    }
  </style>
</head>
<body style="margin: 0; padding: 0; background-color: #F4F6F5; -webkit-text-size-adjust: 100%; -ms-text-size-adjust: 100%;">
  <table role="presentation" width="100%" border="0" cellpadding="0" cellspacing="0" class="email-wrapper" style="background-color: #F4F6F5; width: 100% !important; margin: 0; padding: 24px 8px;">
    <tr>
      <td align="center" style="vertical-align: top; padding: 0;">
        
        <!--[if (gte mso 9)|(IE)]>
        <table align="center" border="0" cellspacing="0" cellpadding="0" width="600" style="width: 600px;">
        <tr>
        <td align="center" valign="top" width="600">
        <![endif]-->

        <table role="presentation" class="email-container" border="0" cellpadding="0" cellspacing="0" width="100%" style="max-width: 580px; width: 100%; background-color: #FFFFFF; border-radius: 0; overflow: hidden; border: 1px solid #E5E7EB; box-shadow: 0 8px 30px rgba(0, 0, 0, 0.06); margin: 0 auto;">
          
          <!-- Master Header Banner: Semi-Transparent Left-to-Right Linear Gradient with Wavy Stripe BG -->
          <tr>
            <td style="padding: 0; background-color: #133824; border-radius: 0;">
              <div style="background-color: #133824; background-image: linear-gradient(90deg, rgba(19, 56, 36, 0.72) 0%, rgba(10, 36, 22, 0.60) 50%, rgba(19, 56, 36, 0.75) 100%), url('<%= typeof emailAssetsUrl !== 'undefined' ? emailAssetsUrl : '' %>/stripe.png'); background-size: cover; background-position: center; background-repeat: repeat-x; padding: 28px 20px 26px; text-align: center; border-radius: 0;">
                <a href="https://goeatone.com" target="_blank" style="text-decoration: none; display: inline-block;">
                  <img 
                    src="<%= typeof emailAssetsUrl !== 'undefined' ? emailAssetsUrl + '/logo.png' : 'cid:goeat_logo' %>" 
                    alt="GoEatOne" 
                    style="height: 32px; width: auto; max-width: 180px; display: block; margin: 0 auto; border: 0;" 
                  />
                </a>
              </div>
            </td>
          </tr>

          <% if (typeof heroTitle !== 'undefined' && heroTitle && (typeof hideHeaderTitle === 'undefined' || !hideHeaderTitle)) { %>
          <!-- Master Title Section (Right after the linear bg, bold, normal casing, NO duplicate logo) -->
          <tr>
            <td style="padding: 30px 28px 10px; background-color: #FFFFFF; text-align: center; border-radius: 0;">
              <h1 class="brand-heading" style="font-family: 'Bricolage Grotesque', 'Poppins', -apple-system, sans-serif; font-size: 26px; line-height: 1.25; font-weight: 800; color: #111827; margin: 0 0 6px; text-align: center; letter-spacing: -0.3px;">
                <%= heroTitle %>
              </h1>
              <% if (typeof heroSubtitle !== 'undefined' && heroSubtitle) { %>
              <div style="font-family: 'Poppins', sans-serif; font-size: 13px; font-weight: 700; color: #F59E0B; letter-spacing: 0.5px;">
                <%= heroSubtitle %>
              </div>
              <% } %>
            </td>
          </tr>
          <% } %>

          <!-- Dynamic Email Content Body -->
          <tr>
            <td class="email-body" style="padding: 0; background-color: #FFFFFF; border-radius: 0;">
              <%- body %>
            </td>
          </tr>

          <!-- Master Clean Editorial Footer Component -->
          <tr>
            <td style="background-color: #FFFFFF; padding: 28px 24px 16px; border-top: 1px solid #F3F4F6; text-align: center; border-radius: 0;">
              <p style="font-size: 13px; line-height: 1.55; color: #6B7280; margin: 0 0 16px; font-family: 'Poppins', sans-serif;">
                If you have any questions, reach out to us at <a href="mailto:support@goeatone.com" style="color: #F59E0B; text-decoration: none; font-weight: 700;">support@goeatone.com</a> or visit our Help Center.
              </p>

              <!-- Subtle Centered Divider -->
              <div style="width: 100px; height: 1px; background-color: #E5E7EB; margin: 0 auto 16px;"></div>

              <!-- 5 Social Links from Web App (Users) -->
              <div style="margin-bottom: 16px; text-align: center;">
                <!-- Twitter / X -->
                <a href="https://x.com/goeatonehq" target="_blank" style="display: inline-block; margin: 0 6px; text-decoration: none;">
                  <img src="<%= typeof emailAssetsUrl !== 'undefined' ? emailAssetsUrl + '/social-x.png' : 'cid:goeat_social-x' %>" alt="X" width="26" height="26" style="width: 26px; height: 26px; display: inline-block; border: 0;" />
                </a>
                <!-- Instagram -->
                <a href="https://www.instagram.com/goeatonehq" target="_blank" style="display: inline-block; margin: 0 6px; text-decoration: none;">
                  <img src="<%= typeof emailAssetsUrl !== 'undefined' ? emailAssetsUrl + '/social-instagram.png' : 'cid:goeat_social-instagram' %>" alt="Instagram" width="26" height="26" style="width: 26px; height: 26px; display: inline-block; border: 0;" />
                </a>
                <!-- TikTok -->
                <a href="https://www.tiktok.com/@goeatone.com" target="_blank" style="display: inline-block; margin: 0 6px; text-decoration: none;">
                  <img src="<%= typeof emailAssetsUrl !== 'undefined' ? emailAssetsUrl + '/social-tiktok.png' : 'cid:goeat_social-tiktok' %>" alt="TikTok" width="26" height="26" style="width: 26px; height: 26px; display: inline-block; border: 0;" />
                </a>
                <!-- Facebook -->
                <a href="https://facebook.com/GoEatHQ" target="_blank" style="display: inline-block; margin: 0 6px; text-decoration: none;">
                  <img src="<%= typeof emailAssetsUrl !== 'undefined' ? emailAssetsUrl + '/social-facebook.png' : 'cid:goeat_social-facebook' %>" alt="Facebook" width="26" height="26" style="width: 26px; height: 26px; display: inline-block; border: 0;" />
                </a>
                <!-- LinkedIn -->
                <a href="https://linkedin.com/company/goeatone" target="_blank" style="display: inline-block; margin: 0 6px; text-decoration: none;">
                  <img src="<%= typeof emailAssetsUrl !== 'undefined' ? emailAssetsUrl + '/social-linkedin.png' : 'cid:goeat_social-linkedin' %>" alt="LinkedIn" width="26" height="26" style="width: 26px; height: 26px; display: inline-block; border: 0;" />
                </a>
              </div>

              <!-- Navigation Links Row -->
              <div style="font-size: 11.5px; font-weight: 600; color: #9CA3AF; margin-bottom: 10px; font-family: 'Poppins', sans-serif;">
                <a href="https://goeatone.com" style="color: #6B7280; text-decoration: none; margin: 0 6px;">GoEatOne</a> |
                <a href="https://goeatone.com/how-it-works" style="color: #6B7280; text-decoration: none; margin: 0 6px;">How it works</a> |
                <a href="https://goeatone.com/support" style="color: #6B7280; text-decoration: none; margin: 0 6px;">FAQs</a> |
                <a href="https://goeatone.com/privacy" style="color: #6B7280; text-decoration: none; margin: 0 6px;">T&Cs</a>
              </div>

              <!-- Copyright -->
              <div style="font-size: 10.5px; color: #9CA3AF; margin-bottom: 4px; font-family: 'Poppins', sans-serif;">
                © <%= typeof year !== 'undefined' ? year : 2026 %> GoEatOne. All rights reserved.
              </div>
            </td>
          </tr>

          <!-- Far Bottom Signature Yellow River Flow Band (Edge-to-Edge) -->
          <tr>
            <td style="padding: 0; margin: 0; line-height: 0; font-size: 0; background-color: #FFFFFF; width: 100%; border-radius: 0; overflow: hidden;">
              <div class="river-flow-stripe" style="width: 100%; height: 32px; line-height: 0; font-size: 0; overflow: hidden; background-color: #FFFFFF; background-image: url('<%= typeof emailAssetsUrl !== 'undefined' ? emailAssetsUrl + '/stripe.png' : 'cid:goeat_stripe' %>'); background-repeat: repeat-x; background-size: auto 32px; background-position: center bottom;">
                <img 
                  src="<%= typeof emailAssetsUrl !== 'undefined' ? emailAssetsUrl + '/stripe.png' : 'cid:goeat_stripe' %>" 
                  alt="" 
                  width="580" 
                  style="width: 100%; max-width: 100%; height: 32px; object-fit: cover; object-position: center bottom; display: block; border: 0; margin: 0;" 
                />
              </div>
            </td>
          </tr>

        </table>

        <!--[if (gte mso 9)|(IE)]>
        </td>
        </tr>
        </table>
        <![endif]-->

      </td>
    </tr>
  </table>
</body>
</html>