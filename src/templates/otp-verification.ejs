<!-- Clean White Body Card -->
<div class="email-content-padding" style="background-color: #FFFFFF; padding: 36px 32px 30px; text-align: center; border-radius: 0;">

  <p style="font-size: 15px; font-weight: 800; color: #133824; margin: 0 0 8px;">
    Hey <%= typeof name !== 'undefined' && name ? name : 'there' %>,
  </p>
  <p style="font-size: 13.5px; line-height: 1.6; color: #4B5563; margin: 0 auto 28px; max-width: 440px;">
    Thanks for signing up with GoEatOne! Use the 6-digit verification code below to verify your email address and start exploring the best food in town.
  </p>

  <!-- BIGGER AND BETTER OTP DISPLAY (Sharp modernist boxes) -->
  <div style="background-color: #F9FAFB; border: 2px dashed #E5E7EB; border-radius: 0; padding: 26px 16px 22px; max-width: 460px; margin: 0 auto 26px;">
    <div style="font-size: 11.5px; font-weight: 800; color: #6B7280; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 16px;">
      YOUR 6-DIGIT VERIFICATION CODE
    </div>

    <% 
      var rawOtp = String(typeof otpCode !== 'undefined' ? otpCode : '123456');
      var digits = rawOtp.split('');
    %>

    <table role="presentation" cellpadding="0" cellspacing="0" style="margin: 0 auto;">
      <tr>
        <% digits.forEach(function(digit, idx) { %>
          <td class="otp-digit-td" align="center" style="width: 56px; height: 68px; background-color: #FFFFFF; border: 2.5px solid #133824; border-radius: 0; font-size: 34px; font-weight: 900; color: #133824; text-align: center; line-height: 68px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', monospace; box-shadow: 0 4px 10px rgba(19, 56, 36, 0.08);">
            <%= digit %>
          </td>
          <% if (idx < digits.length - 1) { %>
            <td class="otp-digit-gap" style="width: 8px;"></td>
          <% } %>
        <% }); %>
      </tr>
    </table>

    <div style="font-size: 12.5px; font-weight: 700; color: #059669; margin-top: 18px;">
      ⏱️ Valid for <span style="text-decoration: underline;"><%= typeof validTime !== 'undefined' ? validTime : '10 minutes' %></span> • Do not share with anyone
    </div>
  </div>

  <!-- Chunky Orange Pill CTA Button (Headspace Style) -->
  <div style="margin: 28px 0 24px;">
    <a href="https://goeatone.com" target="_blank" style="display: inline-block; background-color: #F59E0B; color: #133824 !important; text-decoration: none; font-weight: 900; font-size: 15px; padding: 16px 52px; border-radius: 999px; text-align: center; text-transform: uppercase; letter-spacing: 0.4px; box-shadow: 0 6px 18px rgba(245, 158, 11, 0.35);">
      Verify Account Now
    </a>
  </div>

  <p style="font-size: 12px; line-height: 1.5; color: #9CA3AF; margin: 0 auto; max-width: 400px;">
    If you didn't create a GoEatOne account, you can safely ignore this email. Someone may have mistyped their email address.
  </p>

</div>
