<!-- Security Key Badge -->
<div style="text-align: center; margin: 10px 0 16px;">
  <span style="display: inline-block; padding: 6px 16px; border-radius: 20px; background-color: #f5f8f5; border: 1px solid #deebe3; color: #06462f; font-size: 11px; font-weight: bold; letter-spacing: 1px; text-transform: uppercase;">
    Account Security Notice
  </span>
</div>

<!-- Title & Accent Bar -->
<div style="text-align: center;">
  <h1 style="margin: 0; font-size: 24px; font-weight: 800; color: #06462f; letter-spacing: -0.3px;">
    Reset Your Password
  </h1>
  <div style="width: 38px; height: 3px; background-color: #ffc629; border-radius: 2px; margin: 10px auto 18px;"></div>
</div>

<!-- Greeting & Message -->
<div style="text-align: center; max-width: 440px; margin: 0 auto 24px;">
  <p style="font-size: 14px; font-weight: 700; color: #06462f; margin: 0 0 8px;">
    Hello <%= typeof name !== 'undefined' && name ? name : 'there' %>,
  </p>
  <p style="font-size: 14px; line-height: 1.6; color: #40564b; margin: 0;">
    We received a request to reset the password for your GoEatOne account. Click the button below to choose a new password. This link is valid for <strong>1 hour</strong>.
  </p>
</div>

<!-- Button -->
<div style="text-align: center; margin: 24px 0 28px;">
  <a href="<%= typeof resetUrl !== 'undefined' ? resetUrl : '#' %>" style="display: inline-block; background-color: #06462f; color: #FFFFFF !important; font-weight: bold; font-size: 14px; padding: 14px 40px; border-radius: 999px; text-decoration: none; text-align: center;">
    Reset My Password
  </a>
</div>

<!-- Security Notice -->
<div style="background-color: #f5f8f5; border: 1px solid #deebe3; border-radius: 12px; padding: 16px 20px; text-align: center; max-width: 460px; margin: 0 auto 10px;">
  <p style="margin: 0; font-size: 12px; color: #557064; line-height: 1.5;">
    If you did not request a password reset, you can safely ignore this email. Your password will remain unchanged.
  </p>
</div>
