<!-- Security Key Hero Illustration -->
<div style="text-align: center; margin: 10px 0 16px;">
  <div style="width: 72px; height: 72px; border-radius: 50%; background-color: #ECFDF5; border: 2px solid #A7F3D0; margin: 0 auto; text-align: center; line-height: 72px; font-size: 32px;">
    🔐
  </div>
</div>

<!-- Title & Accent Bar -->
<div style="text-align: center;">
  <h1 style="margin: 0; font-size: 24px; font-weight: 800; color: #133824; letter-spacing: -0.3px;">
    Reset Your Password
  </h1>
  <div style="width: 38px; height: 3px; background-color: #F59E0B; border-radius: 2px; margin: 10px auto 18px;"></div>
</div>

<!-- Greeting & Message -->
<div style="text-align: center; max-width: 440px; margin: 0 auto 24px;">
  <p style="font-size: 14px; font-weight: 700; color: #1F2937; margin: 0 0 8px;">
    Hello <%= typeof name !== 'undefined' && name ? name : 'there' %>,
  </p>
  <p style="font-size: 13px; line-height: 1.6; color: #4B5563; margin: 0;">
    We received a request to reset the password for your GoEat account. Click the button below to choose a new password. This link is valid for <strong>1 hour</strong>.
  </p>
</div>

<!-- Button -->
<div style="text-align: center; margin: 24px 0 28px;">
  <a href="<%= typeof resetUrl !== 'undefined' ? resetUrl : '#' %>" style="display: inline-block; background-color: #133824; color: #FFFFFF !important; font-weight: 700; font-size: 14px; padding: 13px 36px; border-radius: 999px; text-decoration: none; text-align: center;">
    Reset My Password
  </a>
</div>

<!-- Security Notice -->
<div style="background-color: #F9FAFB; border: 1px solid #F3F4F6; border-radius: 14px; padding: 14px 18px; text-align: center; max-width: 460px; margin: 0 auto;">
  <p style="margin: 0; font-size: 11.5px; color: #6B7280; line-height: 1.4;">
    If you did not request a password reset, you can safely ignore this email. Your password will remain unchanged.
  </p>
</div>
