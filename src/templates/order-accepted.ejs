<!-- Shopping Bag Hero Illustration -->
<div style="text-align: center; margin: 10px 0 14px;">
  <img src="https://res.cloudinary.com/dqtjja88b/image/upload/v1791211867/go_eat_email/email_order_accepted_bag.png" alt="Order Accepted" style="width: 120px; height: auto; display: block; margin: 0 auto;" />
</div>

<!-- Title & Accent Bar -->
<div style="text-align: center;">
  <h1 style="margin: 0; font-size: 22px; font-weight: 800; color: #133824; letter-spacing: -0.3px;">
    Your order has been accepted.
  </h1>
  <div style="width: 38px; height: 3px; background-color: #F59E0B; border-radius: 2px; margin: 10px auto 16px;"></div>
</div>

<!-- Greeting & Message -->
<div style="text-align: center; max-width: 440px; margin: 0 auto 22px;">
  <p style="font-size: 14px; font-weight: 700; color: #1F2937; margin: 0 0 6px;">
    Hi <%= typeof customerName !== 'undefined' && customerName ? customerName : 'there' %>,
  </p>
  <p style="font-size: 13px; line-height: 1.5; color: #4B5563; margin: 0;">
    We've accepted your order and it's being prepared with care.. We'll notify you once it's on the way.
  </p>
</div>

<!-- Itemized Receipt Card -->
<% 
  var curr = typeof currencySymbol !== 'undefined' ? currencySymbol : '₦';
  var orderItems = (typeof items !== 'undefined' && items) ? items : [];
  var totalAmount = typeof total !== 'undefined' ? total : 0;
  var dFee = typeof deliveryFee !== 'undefined' ? deliveryFee : 300;
  var sFee = typeof serviceFee !== 'undefined' ? serviceFee : 170;
  var sTotal = typeof subtotal !== 'undefined' ? subtotal : Math.max(0, totalAmount - dFee - sFee);
%>
<div style="border: 1px solid #E5E7EB; border-radius: 18px; padding: 18px 20px; background-color: #FFFFFF; margin-bottom: 22px;">
  
  <!-- Header Row: Item | Qty | Price -->
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-bottom: 1px solid #F3F4F6; padding-bottom: 10px; margin-bottom: 12px;">
    <tr>
      <td style="font-size: 12px; font-weight: 800; color: #133824;">Item</td>
      <td align="center" style="font-size: 12px; font-weight: 800; color: #133824; width: 60px;">Qty</td>
      <td align="right" style="font-size: 12px; font-weight: 800; color: #133824; width: 80px;">Price</td>
    </tr>
  </table>

  <!-- Items Rows -->
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
    <% if (orderItems.length > 0) { %>
      <% orderItems.forEach(function(itemObj) { 
           var fItem = itemObj.foodItem || itemObj;
           var qty = itemObj.quantity || 1;
           var price = itemObj.price || fItem.price || 0;
           var name = fItem.name || itemObj.name || 'Delicious Meal';
           var outlet = itemObj.restaurantName || fItem.restaurantName || 'GoEat Partner';
           var img = fItem.image || itemObj.image || 'https://res.cloudinary.com/dqtjja88b/image/upload/v1791211867/go_eat_email/email_order_accepted_bag.png';
      %>
      <tr>
        <td style="padding: 10px 0; border-bottom: 1px solid #F3F4F6; vertical-align: middle;">
          <table role="presentation" cellpadding="0" cellspacing="0">
            <tr>
              <td style="width: 44px; padding-right: 12px; vertical-align: middle;">
                <img src="<%= img %>" alt="<%= name %>" style="width: 42px; height: 42px; border-radius: 50%; object-fit: cover; display: block; border: 1px solid #E5E7EB;" />
              </td>
              <td style="vertical-align: middle;">
                <div style="font-size: 13px; font-weight: 700; color: #111827;"><%= name %></div>
                <div style="font-size: 11px; color: #6B7280; margin-top: 2px;"><%= outlet %></div>
              </td>
            </tr>
          </table>
        </td>
        <td align="center" style="padding: 10px 0; border-bottom: 1px solid #F3F4F6; vertical-align: middle; font-size: 12.5px; font-weight: 600; color: #4B5563;">
          x<%= qty %>
        </td>
        <td align="right" style="padding: 10px 0; border-bottom: 1px solid #F3F4F6; vertical-align: middle; font-size: 13px; font-weight: 700; color: #111827;">
          <%= curr %><%= Number(price * qty).toLocaleString() %>
        </td>
      </tr>
      <% }); %>
    <% } else { %>
      <tr>
        <td colspan="3" style="padding: 10px 0; font-size: 13px; color: #6B7280;">Order Items</td>
      </tr>
    <% } %>
  </table>

  <!-- Price Summary -->
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin-top: 14px;">
    <tr>
      <td style="padding: 4px 0; font-size: 12.5px; color: #6B7280;">Subtotal</td>
      <td align="right" style="padding: 4px 0; font-size: 12.5px; font-weight: 700; color: #111827;">
        <%= curr %><%= Number(sTotal).toLocaleString() %>
      </td>
    </tr>
    <tr>
      <td style="padding: 4px 0; font-size: 12.5px; color: #6B7280;">
        Delivery fee <span style="font-size: 10px; color: #9CA3AF;">ⓘ</span>
      </td>
      <td align="right" style="padding: 4px 0; font-size: 12.5px; font-weight: 600; color: #111827;">
        <%= curr %><%= Number(dFee).toLocaleString() %>
      </td>
    </tr>
    <tr>
      <td style="padding: 4px 0; font-size: 12.5px; color: #6B7280;">
        Service fee <span style="font-size: 10px; color: #9CA3AF;">ⓘ</span>
      </td>
      <td align="right" style="padding: 4px 0; font-size: 12.5px; font-weight: 600; color: #111827;">
        <%= curr %><%= Number(sFee).toLocaleString() %>
      </td>
    </tr>
    <tr>
      <td colspan="2" style="padding-top: 10px; border-bottom: 1px solid #F3F4F6;"></td>
    </tr>
    <tr>
      <td style="padding-top: 12px; font-size: 14px; font-weight: 700; color: #111827;">Total paid</td>
      <td align="right" style="padding-top: 12px; font-size: 18px; font-weight: 800; color: #111827;">
        <%= curr %><%= Number(totalAmount).toLocaleString() %>
      </td>
    </tr>
  </table>

</div>

<!-- Signoff -->
<div style="text-align: center; margin-top: 10px;">
  <p style="font-size: 12.5px; font-weight: 600; color: #4B5563; margin: 0;">
    Thank you for ordering with <strong style="color: #133824;">GO<span style="color: #F59E0B;">EAT</span></strong>
  </p>
</div>
